<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/blackBacnground"
  android:keepScreenOn="true"
  tools:context="com.shiyunjin.easycontrolnext.app.client.view.FullActivity">

  <EditText
    android:id="@+id/edit_text"
    android:layout_width="10dp"
    android:layout_height="10dp"
    android:inputType="textVisiblePassword" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/texture_view_layout"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="horizontal" />

    <!-- Bottom nav: frosted dark bar -->
    <LinearLayout
      android:id="@+id/nav_bar"
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:layout_gravity="bottom"
      android:background="#E6121214"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingStart="72dp"
      android:paddingEnd="16dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_back"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:focusable="false"
          android:src="@drawable/caret_left"
          android:tint="#F2F2F2" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="返回"
          android:textColor="#B3FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_home"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:focusable="false"
          android:src="@drawable/o"
          android:tint="#F2F2F2" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="主页"
          android:textColor="#B3FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_switch"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:focusable="false"
          android:src="@drawable/square"
          android:tint="#F2F2F2" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="多任务"
          android:textColor="#B3FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_auto_rotate"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:focusable="false"
          android:src="@drawable/un_auto"
          android:tint="#8AB4F8" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="旋转"
          android:textColor="#B3FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <!-- More FAB -->
  <FrameLayout
    android:id="@+id/button_more"
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:layout_gravity="bottom|start"
    android:layout_marginStart="12dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/background_round"
    android:backgroundTint="#3A70FC"
    android:elevation="8dp"
    android:focusable="false">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_gravity="center"
      android:src="@drawable/more"
      android:tint="#FFFFFF" />
  </FrameLayout>

  <!-- Action panel -->
  <LinearLayout
    android:id="@+id/bar_view"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_marginStart="12dp"
    android:layout_marginBottom="72dp"
    android:background="@drawable/background_cron"
    android:backgroundTint="#F21C1C1E"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="6dp"
      android:paddingBottom="6dp"
      android:text="投屏控制"
      android:textColor="#E8EAED"
      android:textSize="13sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:orientation="horizontal">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_app"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:focusable="false"
          android:src="@drawable/share"
          android:tint="#E8EAED" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="应用"
          android:textColor="#99FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_mini"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:focusable="false"
          android:src="@drawable/minus"
          android:tint="#E8EAED" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="挂起"
          android:textColor="#99FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_small"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:focusable="false"
          android:src="@drawable/window_restore"
          android:tint="#E8EAED" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="小窗"
          android:textColor="#99FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_close"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:focusable="false"
          android:src="@drawable/x"
          android:tint="#F2B8B5" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="断开"
          android:textColor="#99FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="4dp"
      android:layout_marginBottom="4dp"
      android:background="#33FFFFFF" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:orientation="horizontal">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_rotate"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:focusable="false"
          android:src="@drawable/horizontal_rotate"
          android:tint="#E8EAED" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="横竖屏"
          android:textColor="#99FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_nav_bar"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:focusable="false"
          android:src="@drawable/not_equal"
          android:tint="#E8EAED" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="导航栏"
          android:textColor="#99FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_power"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:focusable="false"
          android:src="@drawable/power"
          android:tint="#E8EAED" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="电源"
          android:textColor="#99FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/button_light"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:focusable="false"
          android:src="@drawable/lightbulb_off"
          android:tint="#E8EAED" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="背光"
          android:textColor="#99FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
